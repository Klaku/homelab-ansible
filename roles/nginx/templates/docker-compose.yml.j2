---
name: nginx

services:
  nginx:
    container_name: nginx
    image: nginx:stable-alpine
    volumes:
      - "{{ nginx_base_dir }}/nginx.conf:/etc/nginx/nginx.conf:ro"
      - "{{ nginx_conf_dir }}:/etc/nginx/conf.d:ro"
      - "{{ nginx_certs_dir }}:/etc/letsencrypt:ro"
      - "{{ nginx_logs_dir }}:/var/log/nginx"
    ports:
      - "80:80"
      - "443:443"
    networks: [proxy]
    restart: unless-stopped

networks:
  proxy:
    external: true
