server {
    listen 80;
    server_name auth.{{ certbot_domains[0] }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name auth.{{ certbot_domains[0] }};

    resolver 127.0.0.11 valid=30s ipv6=off;

    ssl_certificate     /etc/letsencrypt/live/{{ certbot_domains[0] }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ certbot_domains[0] }}/privkey.pem;

    location / {
        set $authentik_upstream https://authentik_server:9443;
        proxy_pass $authentik_upstream;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}