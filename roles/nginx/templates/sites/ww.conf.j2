server {
    listen 80;
    server_name vw.{{ certbot_domains[0] }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name vw.{{ certbot_domains[0] }};

    resolver 127.0.0.11 valid=30s ipv6=off;

    ssl_certificate     /etc/letsencrypt/live/{{ certbot_domains[0] }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ certbot_domains[0] }}/privkey.pem;

    location /admin {
        allow 192.168.72.0/24;
        deny all;

        set $vaultwarden_upstream http://vaultwarden:8080;
        proxy_pass $vaultwarden_upstream;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        set $vaultwarden_upstream http://vaultwarden:8080;
        proxy_pass $vaultwarden_upstream;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    client_max_body_size 128M;

    proxy_http_version 1.1;
    proxy_redirect     off;
    proxy_read_timeout 90s;
    proxy_send_timeout 90s;
    send_timeout       90s;
}